<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <!-- The game has no localized formatting or timezone behavior. Excluding
         ICU and timezone data keeps the initial browser download smaller. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
  </PropertyGroup>

  <!-- Work around a .NET 10.0.12 macOS workload mismatch where Release's
       emcc -O2 pass requests a newer wasm-opt flag than the bundled binary. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="MainJS" Pattern="main.js"
                                      Expression="#[.{fingerprint}]!" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>
</Project>
