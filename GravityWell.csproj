<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Work around a .NET 10.0.12 macOS workload mismatch where Release's
       emcc -O2 pass requests a newer wasm-opt flag than the bundled binary. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>
</Project>
